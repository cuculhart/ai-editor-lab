class Cart:
    def __init__(self) -> None:
        # Internal storage: list of Product objects for accurate price/identity tracking
        self._items: list[Product] = []

    def add(self, product: Product, quantity: int = 1) -> None:
        if quantity < 1:
            raise ValueError("quantity must be >= 1")
        # Add product instances directly for efficient tracking
        for _ in range(quantity):
            self._items.append(product)

    def remove(self, product: Product) -> None:
        # Remove the first matching Product object (same as original behavior)
        try:
            self._items.remove(product)
        except ValueError:
            pass  # Product not in cart, silently ignore

    def count(self, product: Product | None = None) -> int:
        if product is None:
            return len(self._items)
        return self._items.count(product)

    def quantities(self) -> dict[str, int]:
        # Use Counter for efficient counting by product name
        return dict(Counter(p.name for p in self._items))

    def subtotal(self) -> int:
        return sum(p.price for p in self._items)
