with open('style.css', 'w', encoding='utf-8', newline='\n') as f:
    f.write('''body {
    font-family: sans-serif;
    text-align: center;
    background-color: #f0f8ff;
    margin: 0;
    padding: 20px;
}

.game-container {
    max-width: 400px;
    margin: 0 auto;
    background: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

h1 {
    font-size: 24px;
    color: #333;
}

.score-board, .timer-board {
    font-size: 18px;
    margin: 10px 0;
}

#start-button {
    font-size: 18px;
    padding: 10px 20px;
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    margin-bottom: 20px;
}

#start-button:hover {
    background-color: #45a049;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 90px);
    grid-template-rows: repeat(3, 90px);
    gap: 10px;
    justify-content: center;
    margin-bottom: 20px;
}

.cell {
    background-color: #8B4513;
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    width: 90px;
    height: 90px;
}

.mole {
    width: 70px;
    height: 70px;
    background-color: #654321;
    border-radius: 50%;
    position: absolute;
    bottom: -80px;
    left: 10px;
    opacity: 0;
    visibility: hidden;
    transition: bottom 0.15s ease-out, opacity 0.15s ease-out;
    cursor: pointer;
}

.cell.up .mole,
.mole.active,
.mole.up {
    bottom: 10px;
    opacity: 1;
    visibility: visible;
}

#game-over {
    font-size: 20px;
    font-weight: bold;
    color: #d9534f;
    margin-top: 15px;
}
''')

with open('script.js', 'w', encoding='utf-8', newline='\n') as f:
    f.write('''document.addEventListener('DOMContentLoaded', () => {
    const startButton = document.getElementById('start-button');
    const scoreDisplay = document.getElementById('score');
    const timerDisplay = document.getElementById('timer');
    const cells = document.querySelectorAll('.cell');
    const gameOverDisplay = document.getElementById('game-over');
    const finalScoreDisplay = document.getElementById('final-score');

    let score = 0;
    let timeLeft = 30;
    let gameTimer = null;
    let moleTimer = null;
    let isPlaying = false;
    let currentCell = null;

    function startGame() {
        if (isPlaying) return;
        
        score = 0;
        timeLeft = 30;
        scoreDisplay.textContent = score;
        timerDisplay.textContent = timeLeft;
        isPlaying = true;
        startButton.disabled = true;
        if (gameOverDisplay) {
            gameOverDisplay.style.display = 'none';
        }

        cells.forEach(cell => {
            cell.classList.remove('up');
            const mole = cell.querySelector('.mole');
            if (mole) {
                mole.classList.remove('active', 'up');
            }
        });

        gameTimer = setInterval(() => {
            timeLeft--;
            timerDisplay.textContent = timeLeft;
            if (timeLeft <= 0) {
                endGame();
            }
        }, 1000);

        moleTimer = setInterval(randomMole, 900);
        randomMole();
    }

    function randomMole() {
        if (!isPlaying) return;

        cells.forEach(cell => {
            cell.classList.remove('up');
            const mole = cell.querySelector('.mole');
            if (mole) {
                mole.classList.remove('active', 'up');
            }
        });

        const randomIndex = Math.floor(Math.random() * cells.length);
        currentCell = cells[randomIndex];
        currentCell.classList.add('up');
        const mole = currentCell.querySelector('.mole');
        if (mole) {
            mole.classList.add('active', 'up');
        }
    }

    function endGame() {
        isPlaying = false;
        clearInterval(gameTimer);
        clearInterval(moleTimer);

        cells.forEach(cell => {
            cell.classList.remove('up');
            const mole = cell.querySelector('.mole');
            if (mole) {
                mole.classList.remove('active', 'up');
            }
        });

        startButton.disabled = false;
        
        if (finalScoreDisplay) {
            finalScoreDisplay.textContent = score;
        }
        if (gameOverDisplay) {
            gameOverDisplay.style.display = 'block';
        }
        scoreDisplay.textContent = score;
    }

    cells.forEach(cell => {
        const mole = cell.querySelector('.mole');
        
        const hitHandler = (e) => {
            if (!isPlaying) return;
            const isUp = cell.classList.contains('up') || (mole && (mole.classList.contains('active') || mole.classList.contains('up')));
            if (isUp) {
                score++;
                scoreDisplay.textContent = score;
                cell.classList.remove('up');
                if (mole) {
                    mole.classList.remove('active', 'up');
                }
            }
        };

        cell.addEventListener('click', hitHandler);
        if (mole) {
            mole.addEventListener('click', (e) => {
                e.stopPropagation();
                hitHandler(e);
            });
        }
    });

    startButton.addEventListener('click', startGame);
});
''')
print('Files created successfully')
"
