body {
    font-family: sans-serif;
    text-align: center;
    background-color: #f0f8ff;
    margin: 0;
    padding: 20px;
}

.game-container {
    max-width: 400px;
    margin: 0 auto;
    background: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

h1 {
    font-size: 24px;
    color: #333;
}

.score-board, .timer-board {
    font-size: 18px;
    margin: 10px 0;
}

#start-button {
    font-size: 18px;
    padding: 10px 20px;
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    margin-bottom: 20px;
}

#start-button:hover {
    background-color: #45a049;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 90px);
    grid-template-rows: repeat(3, 90px);
    gap: 10px;
    justify-content: center;
    margin-bottom: 20px;
}

.cell {
    background-color: #8B4513;
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    width: 90px;
    height: 90px;
}

.mole {
    width: 70px;
    height: 70px;
    background-color: #654321;
    border-radius: 50%;
    position: absolute;
    bottom: -80px;
    left: 10px;
    opacity: 0;
    visibility: hidden;
    transition: bottom 0.15s ease-out, opacity 0.15s ease-out;
    cursor: pointer;
}

.cell.up .mole,
.mole.active,
.mole.up {
    bottom: 10px;
    opacity: 1;
    visibility: visible;
}

#game-over {
    font-size: 20px;
    font-weight: bold;
    color: #d9534f;
    margin-top: 15px;
}

