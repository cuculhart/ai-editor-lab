import unittest
import subprocess

class TestWhackAMole(unittest.TestCase):
    def test_files_exist(self):
        self.assertTrue(os.path.exists('index.html'))
        self.assertTrue(os.path.exists('style.css'))
        self.assertTrue(os.path.exists('script.js'))

    def test_html_requirements(self):
        with open('index.html', 'r', encoding='utf-8') as f:
            content = f.read()

        self.assertIn('id=\"start-button\"', content)
        self.assertIn('id=\"score\"', content)
        self.assertIn('id=\"timer\"', content)
        self.assertIn('class=\"cell\"', content)
        self.assertIn('class=\"mole\"', content)
        # Check 3x3 cells (at least 9 cells)
        self.assertGreaterEqual(content.count('class=\"cell\"'), 9)
        self.assertGreaterEqual(content.count('class=\"mole\"'), 9)

    def test_js_syntax(self):
        with open('script.js', 'r', encoding='utf-8') as f:
            code = f.read()
        res = subprocess.run(['node', '-c', 'script.js'], capture_output=True, text=True)
        # If node is not installed, skip or check with python parser
        if res.returncode != 0 and 'node' in res.args[0]:
            pass
        # We can also check basic keywords in script.js
        self.assertIn('start-button', code)
        self.assertIn('score', code)
        self.assertIn('timer', code)
        self.assertIn('30', code)

    def test_no_cdn(self):
        for filename in ['index.html', 'style.css', 'script.js']:
            with open(filename, 'r', encoding='utf-8') as f:
                content = f.read()
                self.assertNotIn('cdn', content.lower())
                self.assertNotIn('http://', content)
                self.assertNotIn('https://', content)

if __name__ == '__main__':
    unittest.main()
''')
